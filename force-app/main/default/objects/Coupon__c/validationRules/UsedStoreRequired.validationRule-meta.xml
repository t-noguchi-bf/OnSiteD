<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>UsedStoreRequired</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(UsedDate__c)), ISPICKVAL(UsedStore__c, &quot;&quot;))</errorConditionFormula>
    <errorDisplayField>UsedStore__c</errorDisplayField>
    <errorMessage>使用した店舗を選んでください</errorMessage>
</ValidationRule>
